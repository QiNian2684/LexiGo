<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cn.wordreview.app.lexigo.v213" android:versionCode="341" android:versionName="3.3.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries><intent><action android:name="android.intent.action.TTS_SERVICE" /></intent></queries>
    <application android:label="LexiGo" android:icon="@mipmap/app_icon" android:roundIcon="@mipmap/app_icon"
        android:theme="@style/WordReviewTheme"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security" android:usesCleartextTraffic="false">
        <provider android:name="cn.wordreview.app.StudyShareProvider"
            android:authorities="cn.wordreview.app.lexigo.v213.share" android:exported="false" android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/study/" />
        </provider>
        <activity android:name="cn.wordreview.app.MainActivity" android:exported="true" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
